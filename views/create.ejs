<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Automated Briefing</title>
    <style>
        #articles-container div {
            margin-bottom: 20px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        #articles-container p {
            margin: 5px 0;
        }
        .sent {
            color: blue;
        }
        .system {
            display: inline-block;
            cursor: pointer;
            margin-right: .5rem;
            margin-top: .5rem;
            border: 1px solid red;
            border-radius: 4px;
            padding: .5rem;
        }
    </style>
</head>
<body>
<h2 class="title">Integrated Server</h2>
<div class="container">
    <div class="send-request-complete">
        <h4>Create Articles Briefing</h4>
        <span id="flag7"></span>
        <button class="send-btn-complete">Send Request</button>
        <div class="result-div-complete"></div>
        <a href="/run">Go To Page</a>
    </div>

    <div class="send-request-range">
        <h4>Create Range Briefing</h4>
        <span id="flag-range"></span>
        <input type="date" id="rangeDate">

        <select id="rangePeriod">
            <option value="">Select Period</option>
            <option value="AM">AM</option>
            <option value="PM">PM</option>
        </select>

        <button class="send-btn-range">Send Range Request</button>
        <div class="result-div-range"></div>
    </div>

    <div class="send-request-completevp">
        <h4>Create Score Briefing</h4>
        <span id="flag8"></span>
        <button class="send-btn-completevp">Send Request</button>
        <div class="result-div-completevp"></div>
        <a href="/chart/draw">Go To Page</a>
    </div>
    <div class="send-request-completedm">
        <h4>Create Dominance Briefing</h4>
        <span id="flag9"></span>
        <button class="send-btn-completedm">Send Request</button>
        <div class="result-div-completedm"></div>
        <a href="/dominance">Go To Page</a>
    </div>
    <div>
        <span id="fetchBlockmedia" class="system">fetch blockmedia</span>
        <span id="fetchPriceScore" class="system">fetch price/score</span>
        <span id="fetchDominance" class="system">fetch dominance</span>
    </div>
    <div class="send-request-manual">
        <h4>Recover Missing Briefing</h4>

        <input type="date" id="manualDate">

        <select id="manualPeriod">
            <option value="AM">AM</option>
            <option value="PM">PM</option>
        </select>

        <button id="manualBriefingButton">Generate</button>
        <div id="manualBriefingResult"></div>
    </div>
    <div class="vp-list">
        <h4>Briefing List</h4>
        <div class="result-div-vplist">
            <div><button id="openList">Open List</button></div>
            <div id="vpContainer">

            </div>
        </div>
        <div class="briefing-jobs">
            <h4>Briefing Job History</h4>
            <button id="loadBriefingJobs">Load Jobs</button>
            <div id="briefingJobsResult"></div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>
<script>

    document.querySelector('.send-btn-complete').addEventListener('click', function() {
        document.querySelector('#flag7').textContent = "sent";
        axios.post('/create/complete')
            .then((response) => {
                console.log("success: ", response);
            })
            .catch(err => {
                console.error("failure ", err)
            })
    });

    document.querySelector('.send-btn-completevp').addEventListener('click', function() {
        document.querySelector('#flag8').textContent = "sent";
        axios.post('/chart/price-analysis')
            .then(response => {
                console.log("success: ", response);
            })
            .catch(err => {
                console.error("failure: ", err);
            })
    });

    document.querySelector('.send-btn-completedm').addEventListener('click', function() {
        document.querySelector('#flag9').textContent = "sent";
        axios.post('/dominance/create')
            .then(response => {
                console.log("success: ", response);
            })
            .catch(err => {
                console.error("failure: ", err);
            })
    });

    document.querySelector('#fetchBlockmedia').addEventListener('click', function() {
        document.querySelector('#fetchBlockmedia').classList.add('sent');
        axios.post('/crawl/articles')
            .then(response => {
                console.log("success: ", response);
            })
            .catch(err => {
                console.error("failure: ", err);
            })
    })

    document.querySelector('#fetchPriceScore').addEventListener('click', function() {
        document.querySelector('#fetchPriceScore').classList.add('sent');
        axios.post('/chart/save')
            .then(response => {
                console.log("success: ", response);
            })
            .catch(err => {
                console.error("failure: ", err);
            })
    })

    document.querySelector('#fetchDominance').addEventListener('click', function() {
        document.querySelector('#fetchDominance').classList.add('sent');
        axios.post('/dominance/collect')
            .then(response => {
                console.log("success: ", response);
            })
            .catch(err => {
                console.error("failure: ", err);
            })
    })

    document.querySelector('#openList').addEventListener('click', function() {
        axios.get('/create/open')
            .then(response => {
                console.log("success: ", response.data);
                response.data.forEach(item => {
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'item';
                    const idElement = document.createElement('h3');
                    idElement.textContent = `ID: ${item.id}`;
                    itemDiv.appendChild(idElement);

                    const analysesElement = document.createElement('ul');
                    item.Analyses.forEach(analysis => {
                        const analysisItem = document.createElement('li');
                        analysisItem.textContent = `Analysis ID: ${analysis.id}, ${analysis.createdAt} `;
                        analysesElement.appendChild(analysisItem);
                    })

                    itemDiv.appendChild(analysesElement);

                    document.querySelector('#vpContainer').appendChild(itemDiv);

                })
            })
            .catch(err => {
                console.error("failure: ", err);
            })
    })

    document.querySelector('#loadBriefingJobs')
        .addEventListener('click', async function () {
            const container = document.querySelector('#briefingJobsResult');

            container.textContent = 'Loading...';

            try {
                const response = await axios.get('/briefing-jobs?limit=20');
                const jobs = response.data.jobs;

                container.replaceChildren();

                if (jobs.length === 0) {
                    container.textContent = 'No briefing jobs found.';
                    return;
                }

                jobs.forEach(job => {
                    const itemDiv = document.createElement('div');

                    const title = document.createElement('h4');
                    title.textContent = `${job.id} - ${job.status}`;

                    const details = document.createElement('p');
                    details.textContent =
                        `Attempts: ${job.attemptCount} | ` +
                        `Started: ${formatKST(job.startedAt)} | ` +
                        `Completed: ${formatKST(job.completedAt)}`;

                    const error = document.createElement('p');

                    if (job.lastErrorCode) {
                        error.style.color = 'red';
                        error.textContent =
                            `Error: ${job.lastErrorCode}`;
                    }

                    const retry = document.createElement('p');

                    if (job.nextRetryAt) {
                        retry.textContent =
                            `Next retry: ${formatKST(job.nextRetryAt)}`;
                    }

                    itemDiv.appendChild(title);
                    itemDiv.appendChild(details);
                    itemDiv.appendChild(error);
                    itemDiv.appendChild(retry);

                    container.appendChild(itemDiv);
                });

            } catch (err) {
                console.error('Failed to load briefing jobs:', err);
                container.textContent = 'Failed to load briefing jobs.';
            }
        });


    document.querySelector('#manualBriefingButton')
        .addEventListener('click', async () => {
            const date = document.querySelector('#manualDate').value;
            const period = document.querySelector('#manualPeriod').value;
            const output = document.querySelector('#manualBriefingResult');

            if (!date) {
                output.textContent = '날짜를 선택하세요.';
                return;
            }

            output.textContent = 'Generating...';

            try {
                const response = await axios.post(
                    '/briefing-manual/complete',
                    { date, period }
                );

                output.textContent = JSON.stringify(response.data);
            } catch (error) {
                output.textContent =
                    error.response?.data?.error ||
                    error.response?.data?.message ||
                    'Generation failed';
            }
        });


    function formatKST(value) {
        if (!value) return '-';

        return new Date(value).toLocaleString('ko-KR', {
            timeZone: 'Asia/Seoul',
            hour12: false
        });
    }


</script>


<script>
    document.querySelector('.send-btn-range').addEventListener('click', function() {
        const date = document.querySelector('#rangeDate').value;
        const period = document.querySelector('#rangePeriod').value;

        if (!date) {
            alert('날짜를 선택하세요.');
            return;
        }

        if (!period) {
            alert('AM 또는 PM을 선택하세요.');
            return;
        }

        document.querySelector('#flag-range').textContent = "sent";

        axios.post('/create-range/complete', { date, period })
            .then((response) => {
                console.log("range success: ", response);
                document.querySelector('.result-div-range').textContent =
                    response.data?.result || 'success';
            })
            .catch(err => {
                console.error("range failure ", err);
                document.querySelector('.result-div-range').textContent =
                    err.response?.data?.error || 'request failed';
            });
    });
</script>
</body>
</html>